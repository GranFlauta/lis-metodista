# Copiar a .env y CAMBIAR todos los valores marcados. NUNCA subir .env a git.
POSTGRES_DB=lis
POSTGRES_USER=lis_app
POSTGRES_PASSWORD=CAMBIAR_por_una_clave_larga_y_aleatoria

# Clave para firmar tokens (generar con: openssl rand -hex 32)
JWT_SECRET=CAMBIAR_openssl_rand_hex_32

# Sesión (ver docs/DECISIONES.md §6)
HEARTBEAT_INTERVAL_SECONDS=30
SESSION_DEAD_AFTER_SECONDS=150
IDLE_TIMEOUT_MINUTES=30
ABSOLUTE_SESSION_HOURS=12

# Dominio/IP con la que los PCs del laboratorio abren el sistema (HTTPS interno)
LIS_HOST=lis.local
BACKUP_RETENTION_DAYS=30
